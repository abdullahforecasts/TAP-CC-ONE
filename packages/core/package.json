{
  "name": "@tap/core",
  "version": "0.1.0",
  "description": "TAP-CC-ONE core: log format, hash chain, signatures, replay, provenance and verification.",
  "author": "Abdullah Nawaz",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:browser-check": "esbuild src/index.ts --bundle --platform=browser --format=esm --outfile=dist-browser/core.browser.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "cborg": "4.5.8",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
