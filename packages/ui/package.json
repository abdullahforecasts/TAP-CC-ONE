    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node build.mjs && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@preact/signals": "2.11.2",
    "@tap/core": "workspace:*",
    "preact": "10.29.8",
    "@tap/anchor": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "happy-dom": "20.14.5",
    "vite": "7.3.7"
  }
}
