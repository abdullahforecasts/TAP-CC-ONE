{
  "name": "@tap/ui",
  "private": true,
  "version": "0.3.0",
  "description": "TAP-CC-ONE viewer: Save History, replay player, timeline, integrity checklist, composition.",
  "author": "Abdullah Nawaz",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./model": {
      "source": "./src/model/index.ts",
      "default": "./src/model/index.ts"
    }
