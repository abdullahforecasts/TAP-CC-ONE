{
  "name": "tap-cc-one",
  "displayName": "TAP-CC-ONE: Code Authorship Log",
  "description": "Records a tamper-evident history of how your code was written, so you can prove your work is your own.",
  "icon": "icon.png",
  "version": "0.3.0",
  "publisher": "abdullahforecasts",
  "author": "Abdullah Nawaz",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdullahforecasts/TAP-CC-ONE"
  },
  "homepage": "https://github.com/abdullahforecasts/TAP-CC-ONE#readme",
  "bugs": {
    "url": "https://github.com/abdullahforecasts/TAP-CC-ONE/issues"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "plagiarism",
    "authorship",
    "academic integrity",
    "students",
    "proof of work"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:.tap/config.json",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "tap.viewLog",
        "title": "View Log (Save History & Replay)",
        "category": "TAP",
        "icon": "$(history)"
      },
      {
        "command": "tap.start",
        "title": "Start Recording This Folder",
        "category": "TAP",
        "icon": "$(record)"
      },
      {
        "command": "tap.stop",
        "title": "Stop Recording This Folder",
        "category": "TAP",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tap.pause",
        "title": "Pause Recording",
        "category": "TAP",
        "icon": "$(debug-pause)"
      },
      {
        "command": "tap.resume",
        "title": "Resume Recording",
        "category": "TAP",
        "icon": "$(debug-continue)"
      },
      {
        "command": "tap.addNote",
        "title": "Add Note to Log",
        "category": "TAP",
        "icon": "$(note)"
      },
      {
        "command": "tap.showFingerprint",
        "title": "Show Key Fingerprint",
        "category": "TAP",
        "icon": "$(key)"
      },
      {
        "command": "tap.verifyCurrent",
        "title": "Verify Log Integrity",
        "category": "TAP",
        "icon": "$(verified)"
      },
      {
        "command": "tap.showMenu",
        "title": "Show Recording Menu",
        "category": "TAP",
        "icon": "$(list-unordered)"
      },
      {
        "command": "tap.timestampNow",
        "title": "Timestamp Now",
        "category": "TAP",
        "icon": "$(watch)"
      },
      {
        "command": "tap.export",
        "title": "Export for Submission",
        "category": "TAP",
        "icon": "$(package)"
      },
      {
        "command": "tap.openLogFile",
        "title": "Open Log File or Submission\u2026",
        "category": "TAP",
        "icon": "$(file-zip)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tap.showMenu",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "tap.openLogFile",
          "when": "resourceExtname == .codelog || resourceExtname == .zip",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "TAP-CC-ONE",
      "properties": {
        "tap.promptOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Ask whether to record authorship history when a folder containing code is opened."
        },
        "tap.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.{c,h,cpp,cc,cxx,hpp,hh,hxx,py,pyw,ipynb,java,kt,kts,js,jsx,mjs,cjs,ts,tsx,cs,go,rs,rb,php,swift,m,mm,sql,html,htm,css,scss,sass,less,sh,bash,zsh,ps1,r,jl,hs,ml,mli,scala,lua,dart,asm,s,vhd,vhdl,v,sv,md,txt,json,yaml,yml,toml,xml,gradle,cmake,mk}",
            "**/Makefile",
            "**/makefile",
            "**/CMakeLists.txt",
            "**/Dockerfile"
          ],
          "description": "Glob patterns (relative to the folder) of files to record. Copied into .tap/config.json when recording starts."
        },
        "tap.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/.tap/**",
            "**/node_modules/**",
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/build/**",
            "**/dist/**",
            "**/out/**",
            "**/target/**",
            "**/bin/**",
            "**/obj/**",
            "**/.idea/**",
            "**/.vscode-test/**",
            "**/.pnpm-store/**"
          ],
          "description": "Glob patterns of files never recorded. Copied into .tap/config.json when recording starts."
        },
        "tap.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "maximum": 4096,
          "description": "Files larger than this are not recorded."
        },
        "tap.record.focus": {
          "type": "boolean",
          "default": true,
          "description": "Record when the VS Code window gains or loses focus. Disclosed in the log."
        },
        "tap.classify.clipboardCheckMinChars": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Insertions at least this long are compared with the clipboard to detect pastes. The clipboard itself is never stored."
        },
        "tap.classify.bulkMinChars": {
          "type": "number",
          "default": 40,
          "minimum": 2,
          "description": "Non-paste insertions at least this long are marked as bulk insertions (completions, snippets, AI suggestions)."
        },
        "tap.checkpoint.intervalSec": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "description": "How often a signed checkpoint is written while you are working."
        },
        "tap.record.terminalCommands": {
          "type": "boolean",
          "default": true,
          "description": "Record commands run in VS Code's terminal (the full command line, with passwords and tokens masked) and their exit codes. Needs terminal shell integration. Disclosed in the log."
        },
        "tap.anchoring.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Have checkpoints timestamped by independent services, so the times in the log can be trusted. Only a 32-byte fingerprint of the log is sent, never your code. Turning this off is disclosed in the log."
        },
        "tap.anchoring.intervalSec": {
          "type": "number",
          "default": 600,
          "minimum": 120,
          "description": "How often the newest checkpoint is timestamped while you work (nothing is sent when nothing changed)."
        },
        "tap.anchoring.tsa": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "https://freetsa.org/tsr",
            "http://timestamp.digicert.com",
            "http://timestamp.sectigo.com"
          ],
          "description": "RFC 3161 time-stamp authorities. Two are used per round, in turn. A token that would not verify with the bundled root certificates is not used, and another authority is asked."
        },
        "tap.anchoring.ots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "https://alice.btc.calendar.opentimestamps.org",
            "https://bob.btc.calendar.opentimestamps.org",
            "https://finney.calendar.eternitywall.com"
          ],
          "description": "OpenTimestamps calendars (proofs anchored in Bitcoin). One is used per round, in turn."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node build.mjs --production && vsce package --no-dependencies --out tap-cc-one-0.3.0.vsix",
    "test:integration": "node build.mjs && node build.mjs --tests && node ./out/test/runTest.cjs"
  },
  "dependencies": {
    "@tap/core": "workspace:*",
    "picomatch": "4.0.7",
    "@tap/anchor": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@tap/ui": "workspace:*",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "@types/vscode": "1.93.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "mocha": "11.7.5"
  }
}
