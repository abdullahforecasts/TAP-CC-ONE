{
  "name": "tap-cc-one",
  "private": true,
  "version": "0.0.0",
  "description": "Tamper-evident, independently timestamped authorship logs for code written in VS Code.",
  "author": "Abdullah Nawaz",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:browser-check": "pnpm --filter @tap/core run build:browser-check",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "vectors:generate": "tsx --conditions=source tools/gen-vectors/src/main.ts",
    "vectors:check": "tsx --conditions=source tools/gen-vectors/src/main.ts --check",
    "bench": "tsx --conditions=source tools/bench/src/main.ts",
    "fuzz": "tsx --conditions=source tools/fuzz/src/main.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm build:browser-check && pnpm vectors:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
